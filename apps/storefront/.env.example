# Keys only (CLAUDE.md §11). Local values: `npm run dev:env` writes .env.local for every app.
# NODE_ENV is set by Next.js itself and must not be put in env files.

# --- Server only (never sent to the browser) ---
# This app's own origin, e.g. https://www.example.com (must equal NEXT_PUBLIC_STOREFRONT_URL)
APP_ORIGIN=
# Backend origin without /api/v1
NILE_API_BASE_URL=
# Secret. JSON object {"<key id>":"<base64 of 32 random bytes>"}; keep old keys for 30 days after rotating
SESSION_ENCRYPTION_KEYS=
# Key id used to encrypt new sessions; must exist in SESSION_ENCRYPTION_KEYS
SESSION_ACTIVE_KEY_ID=
# "true" in production (required); "false" only for local http development
SESSION_COOKIE_SECURE=
# Refresh the backend token when it expires within this many seconds (1..600)
REFRESH_SKEW_SECONDS=
# Backend request timeout for BFF calls in ms (1000..60000)
BFF_UPSTREAM_TIMEOUT_MS=
# Maximum JSON body accepted by the BFF in KB (1..1024)
BFF_MAX_BODY_KB=
# fatal | error | warn | info | debug
LOG_LEVEL=

# --- Public (inlined into the browser bundle at build time: never secrets) ---
# Must be "storefront"
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_STOREFRONT_URL=
NEXT_PUBLIC_SELLER_URL=
NEXT_PUBLIC_ADMIN_URL=
NEXT_PUBLIC_AGENT_URL=
# Browser-side proactive refresh, seconds before expiry (1..600, not greater than REFRESH_SKEW_SECONDS)
NEXT_PUBLIC_REFRESH_SKEW_SECONDS=
# Realtime service origin (Socket.IO at /realtime), e.g. https://api.example.com; locally http://localhost:3001
NEXT_PUBLIC_REALTIME_URL=
# Public images (media CDN), e.g. https://media.example.com; locally MinIO http://localhost:9100
NEXT_PUBLIC_MEDIA_PUBLIC_ORIGIN=
# Host of presigned private images (storage), e.g. https://bucket.s3.example.com; locally http://localhost:9100
NEXT_PUBLIC_MEDIA_PRIVATE_ORIGIN=
# Host of presigned uploads (storage), e.g. https://bucket.s3.example.com; locally http://localhost:9100
NEXT_PUBLIC_MEDIA_UPLOAD_ORIGIN=
# Card payment window shown in checkout copy, minutes (1..120); keep equal to the backend's KASHIER_PAYMENT_TTL_MINUTES
NEXT_PUBLIC_KASHIER_PAYMENT_WINDOW_MINUTES=
