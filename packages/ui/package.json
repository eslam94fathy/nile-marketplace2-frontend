  },
  "devDependencies": {
    "@nile/config": "*",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
