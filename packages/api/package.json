{
  "name": "@nile/api",
  "version": "0.0.0",
  "private": true,
  "description": "Backend contract: OpenAPI snapshot, corrections, generated types and the typed client",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/generated/schema.d.ts"
  },
  "scripts": {
    "api:pull": "node scripts/pull.ts",
    "api:gen": "node scripts/generate.ts",
    "api:check": "node scripts/generate.ts --check",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@nile/config": "*",
    "msw": "3.0.3",
    "openapi-typescript": "7.13.0"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  }
}
