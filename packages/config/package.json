{
  "name": "@nile/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript, ESLint and Vitest presets",
  "type": "module",
  "exports": {
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/nextjs.json": "./tsconfig/nextjs.json",
    "./tsconfig/library.json": "./tsconfig/library.json",
    "./eslint": "./eslint/index.mjs",
    "./vitest": "./vitest/preset.mjs",
    "./env": "./src/env/index.ts",
    "./tsconfig/react-library.json": "./tsconfig/react-library.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tanstack/eslint-plugin-query": "5.104.2",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "10.1.8",
    "typescript-eslint": "8.71.2"
  }
}
